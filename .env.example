# ===== Telegram =====
# Get your token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Comma or space separated list of Telegram user IDs with admin access
ADMIN_IDS=123456789

# ===== PostgreSQL =====
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=store
POSTGRES_PASSWORD=store_password
POSTGRES_DB=store_bot

# ===== Store settings =====
# Currency symbol shown to users
CURRENCY=₽
# Notify admins when product stock drops to/below this value
LOW_STOCK_THRESHOLD=5
# Bonus (in currency) credited to a referrer for each invited user
REFERRAL_BONUS=50

# ===== Misc =====
LOG_LEVEL=INFO
# Seed demo categories/products on first start (true/false)
SEED_DEMO_DATA=true
